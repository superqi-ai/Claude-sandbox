# API Keys Configuration
# Copy this file to .env and fill in your API keys

# Anthropic API Key (for image analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API Key (for walking distance calculation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Sheets credentials file path
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Target location for distance calculation
TARGET_ADDRESS=2303 14th St NW, DC 20009
